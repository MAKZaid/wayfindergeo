{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	@www host www.wayfindergeo.co
	redir @www https://wayfindergeo.co{uri} 301

	respond /health 200
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	root * .
	encode gzip zstd
	try_files {path} {path}.html {path}/index.html
	file_server {
		hide .git .env* Caddyfile
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
